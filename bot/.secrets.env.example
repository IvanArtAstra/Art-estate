# ============================================================
#  Estate Art — секреты воркера
# ------------------------------------------------------------
#  Скопируйте в bot/.secrets.env, впишите значения и выполните:
#
#      bash bot/push-secrets.sh
#
#  Скрипт загрузит всё это в секреты Cloudflare и предложит
#  затереть файл. В git он не попадёт: закрыт в .gitignore.
#
#  Значения — без кавычек, без пробелов вокруг «=».
# ============================================================

# Токен бота @EstateArtHomesBot из @BotFather (команда /token).
BOT_TOKEN=

# Ключ Anthropic для первичного менеджера. Оставьте пустым, если
# менеджер пока не нужен: тогда бот работает простым мостом до
# дежурного, а включить можно позже этим же файлом.
ANTHROPIC_API_KEY=

# Куда падают заявки. Один id или несколько через запятую — тогда
# новые диалоги распределяются по кругу.
#
# Личный чат: напишите боту /start и выполните bash bot/chat-id.sh
# Группа: добавьте бота администратором, напишите в неё что-нибудь
#         и выполните bash bot/chat-id.sh — id группы отрицательный,
#         минус обязателен.
AGENT_CHAT_ID=

# Подпись вебхука: любая случайная строка. Если оставить пустым,
# push-secrets.sh сгенерирует сам — запоминать её не нужно.
WEBHOOK_SECRET=
